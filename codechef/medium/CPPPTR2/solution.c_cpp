#include <stdio.h>

// Function to reverse the elements of an array using pointers
void reverseArray(int* arr, int size) {
    // Complete this function 
    int *start = arr;
    int *end = arr + size - 1;
    
    while (start < end) {
        int temp = *start;
        *start = *end;
        *end = temp;
        
        start++;
        end--;
    }
}

int main() {
    int n;
    scanf("%d",&n);
    int arr[n];
    for(int i = 0; i < n; i++){
        scanf("%d",&arr[i]);
    }
   
    // Call the function to reverse the array
    reverseArray(&arr, n);

    for (int i = 0; i < n; i++) {
        printf("%d ",arr[i]);
    }

    return 0;
}
