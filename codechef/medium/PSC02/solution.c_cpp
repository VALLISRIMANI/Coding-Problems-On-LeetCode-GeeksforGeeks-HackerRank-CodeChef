#include <stdio.h>
#include <string.h>

// Function to reverse a string using pointers
void reverseString(char *str) {
   // Complete the function 
   char *start = str;
   char *end = str;
   char temp;
   
   while (*end != '\0') {
       end++;
   }
   end--;
   
   while (start < end) {
       temp = *start;
       *start = *end;
       *end = temp;
       
       start++;
       end--;
   }
}

int main() {
    char str[100];

    scanf("%s", &str);

    // Call the reverseString function
    reverseString(str);

    printf("%s\n", str);

    return 0;
}


